@model MovieAndCast

@{
    ViewData["Title"] = "Movie Details";
}

<div class="container mx-auto">
    <h1 class="my-4" style="color: #f9fafb;">Movie #@Model.Movie.MovieId Details</h1>
    <div class="p-2" style="background-color: #374151; border-radius: 8px;">
        <div class="shadow mx-auto w-25 px-4 py-3 text-center" style="background-color: #1f2937; border-radius: 8px; color: white;">
            @if(!string.IsNullOrEmpty(Model.Movie.Title))
            {
                <h4>@Model.Movie.Title</h4>
            }
            else
            {
                <h4>Title: Brak</h4>
            }
        </div>
    </div>
</div>