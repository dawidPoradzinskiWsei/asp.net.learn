@model Computer
@{
    ViewBag.Title = "Calculator Form";
    Layout = "_layout";
}

<form asp-action="Create" asp-controller="Computer" method="POST">

    @* <div asp-validation-summary="All"></div> *@


    <div>
       <label asp-for="Name"></label>
    </div>
    <div>
        <input class="form-control" type="text" asp-for="Name"/>
    </div>


    <div>
       <label asp-for="Processor"></label>
    </div>

    <span asp-validation-for="Processor" class="text-danger"></span>

    <div>
        <input class="form-control" type="text" asp-for="Processor"/>
    </div>


    <div>
       <label asp-for="RamGB"></label>
    </div>

    <span asp-validation-for="RamGB" class="text-danger"></span>

    <div>
        <input class="form-control" type="number" asp-for="RamGB"/>
    </div>
    
    <div>
       <label asp-for="Gpu"></label>
    </div>
    <div>
        <input class="form-control" type="text" asp-for="Gpu"/>
    </div>

    <div>
       <label asp-for="Producer"></label>
    </div>
    <div>
        <input class="form-control" type="text" asp-for="Producer"/>
    </div>

    <div>
       <label asp-for="YearOfProduction"></label>
    </div>
    <div>
        <input class="form-control" type="date" asp-for="YearOfProduction"/>
    </div>

   <div>
     <label asp-for="Category"></label>
     <div>
         <span asp-validation-for="Category" class="text-danger"></span>
     </div>
     <select class="form-control" asp-for="Category" asp-items="@Html.GetEnumSelectList<Category>()"></select>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="OrganizationId"></label>
        <select class="form-select" asp-for="OrganizationId" asp-items="@Model.Organizations"></select>
        <span class="text-danger" asp-asp-validation-for="OrganizationId"></span>
    </div>
    

 
<button type="submit">Zapisz</button>
</form>