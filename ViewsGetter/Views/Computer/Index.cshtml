@model Dictionary<int, Computer>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<h2>List of Computers</h2>
<table>
    <tr>
        <th>
            Name
        </th>
        <th>
            Procesor
        </th>
        <th>
            GB of RAM
        </th>
        <th>
            GPU
        </th>
        <th>
            Producer
        </th>
        <th>
            Year of production
        </th>
    </tr>
    @foreach(var item in @Model)
    {
        <tr>
            <td>
                @item.Value.name
            </td>
            <td>
                @item.Value.processor
            </td>
            <td>
                @item.Value.ramGB
            </td>
            <td>
                @item.Value.gpu
            </td>
            <td>
                @item.Value.producer
            </td>
            <td>
                @item.Value.yearOfProduction
            </td>
            <td>
                <a class="btn btn-success" 
                    asp-action="Edit" 
                    asp-controller="Computer" 
                    asp-route-id=@item.Value.id>Edycja</a>
                <a class="btn btn-info"
                    asp-action="Details" 
                    asp-controller="Computer" 
                    asp-route-id=@item.Value.id>Szczegoly</a>
                <a class="btn btn-danger" 
                    asp-action="Delete" 
                    asp-controller="Computer" 
                    asp-route-id=@item.Value.id>Usun</a>
            </td>
        </tr>
    }
</table>