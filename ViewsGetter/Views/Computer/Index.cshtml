@model List<Computer>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<h2>List of Computers</h2>

@if(Model.Count > 0) {
<table>
    <tr>
        <th>
            @Html.DisplayNameFor(l => l[0].Name)
        </th>
        <th>
            @Html.DisplayNameFor(l => l[0].Processor)
        </th>
        <th>
            @Html.DisplayNameFor(l => l[0].RamGB)
        </th>
        <th>
            @Html.DisplayNameFor(l => l[0].Gpu)
        </th>
        <th>
            @Html.DisplayNameFor(l => l[0].Producer)
        </th>
        <th>
            @Html.DisplayNameFor(l => l[0].YearOfProduction)
        </th>
        <th>
            @Html.DisplayNameFor(l => l[0].Category)
        </th>
    </tr>
    @foreach(var item in @Model)
    {
        <tr>
            <td>
                @item.Name
            </td>
            <td>
                @item.Processor
            </td>
            <td>
                @item.RamGB
            </td>
            <td>
                @item.Gpu
            </td>
            <td>
                @item.Producer
            </td>
            <td>
                @item.YearOfProduction
            </td>
            <td>
                @item.Category.GetDisplayName()
            </td>
            <td>
                <a class="btn btn-success" 
                    asp-action="Edit" 
                    asp-controller="Computer" 
                    asp-route-id=@item.Id>Edycja</a>
                <a class="btn btn-info"
                    asp-action="Details" 
                    asp-controller="Computer" 
                    asp-route-id=@item.Id>Szczegoly</a>
                <a class="btn btn-danger" 
                    asp-action="Delete" 
                    asp-controller="Computer" 
                    asp-route-id=@item.Id>Usun</a>
            </td>
        </tr>
    }
</table>
}